<Window x:ClassModifier="internal" x:Class="ChudType.UI.Overlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChudType dictation bar"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight"
        Left="-1500" Top="-1500" Focusable="False" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>
  </Window.Resources>
  <StackPanel>
    <Border x:Name="Shell" CornerRadius="24" Padding="5,4" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LogoButton" Style="{StaticResource OverlayButton}" Padding="0" Margin="0"
                Width="34" Height="34" ToolTip="Click to start dictation or drag to move" AutomationProperties.Name="Start dictation"
                Background="Transparent" BorderBrush="Transparent" Click="StartClick">
          <Grid Width="28" Height="28">
            <Ellipse Fill="{DynamicResource AccentBase}"/>
            <Image Source="/ChudType;component/Assets/chudgpt.png" Width="28" Height="28">
              <Image.Clip><EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/></Image.Clip>
            </Image>
          </Grid>
        </Button>
        <StackPanel x:Name="Live" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,4,0">
          <TextBlock x:Name="Label" Text="Ready" VerticalAlignment="Center" MaxWidth="360" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                     Margin="0,0,5,0" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel x:Name="Wave" Width="49" Height="25" Orientation="Horizontal" VerticalAlignment="Center"/>
          <TextBlock x:Name="Clock" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="5,0,0,0"/>
          <ProgressBar x:Name="Working" Width="33" Height="3" IsIndeterminate="True" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="StopButton" Style="{StaticResource OverlayButton}" ToolTip="Finish dictation and insert text"
                AutomationProperties.Name="Finish dictation and insert text" Click="StopClick" VerticalAlignment="Center" Content="Enter ↵"/>
        <Button x:Name="CancelButton" Style="{StaticResource OverlayButton}" ToolTip="Cancel dictation"
                AutomationProperties.Name="Cancel dictation" Click="CancelClick" VerticalAlignment="Center" Content="×"/>
      </StackPanel>
    </Border>
    <Border x:Name="Review" Width="352" Margin="0,5,0,0" CornerRadius="14" Padding="12" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="Detail" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Preview" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="70" Margin="0,7"/>
        <WrapPanel>
          <Button Style="{StaticResource OverlayButton}" Content="Insert" Click="InsertClick"/>
          <Button Style="{StaticResource OverlayButton}" Content="Use raw" Click="RawClick"/>
          <Button Style="{StaticResource OverlayButton}" Content="Copy" Click="CopyClick"/>
          <Button Style="{StaticResource OverlayButton}" Content="Copy raw" Click="CopyRawClick"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
