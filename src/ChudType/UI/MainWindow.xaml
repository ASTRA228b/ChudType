<Window x:ClassModifier="internal" x:Class="ChudType.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChudType"
        Icon="/ChudType;component/Assets/chudgpt.ico" Width="990" Height="760" MinWidth="665" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="183"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="16,24,16,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,24">
          <StackPanel Orientation="Horizontal">
            <Image Source="/ChudType;component/Assets/chudgpt.png" Width="38" Height="38" Margin="0,0,9,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ChudType" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="BY CHUDAI" FontSize="10" Foreground="{DynamicResource Accent}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="CHUDGPT ECOSYSTEM" Foreground="{DynamicResource Muted}" FontSize="9" Margin="3,10,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Padding="28,16" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Panel}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Stop model" Click="StopModelClick" IsEnabled="{Binding CanStopModel, Mode=OneWay}"
                  ToolTip="Cancel active dictation and unload the speech model" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="{Binding ModelStatus, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontSize="12"
                       TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12"
                       Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Page" Margin="28,22,28,22"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="28,10">
        <TextBlock x:Name="Notice" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
    </Grid>
  </Grid>
</Window>
